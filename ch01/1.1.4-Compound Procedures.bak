#lang sicp

; 1.1.4 - Compound Procedures

(define (square x) (* x x))

(square 10) ; 100

(square (+ 2 10)) ; 144

(square (+ 2 5))

(square (square 10)) ; 10^4

(square (square 3))

(+ (square 2) (square 3)) ; 13

(define (sum-of-squares x y)
  (+ (square x) (square y)))

(sum-of-squares 2 3) ; 13

(define (f a)
  (sum-of-squares (+ a 1) (* a 2)))

(f 5) ; 136
